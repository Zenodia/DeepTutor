# DeepTutor Environment Configuration - NVIDIA API Template
# ==========================================
# Copy this file to .env and replace 'your_nvidia_api_key_here' with your actual API key
# Get your API key from: https://build.nvidia.com/

# LLM Configuration - NVIDIA API (Default)
# ==========================================
# Using NVIDIA's OpenAI-compatible API endpoint

# LLM Provider Settings
LLM_BINDING=openai
LLM_MODEL=openai/gpt-oss-120b
LLM_BINDING_HOST=https://integrate.api.nvidia.com/v1
LLM_BINDING_API_KEY=your_nvidia_api_key_here

# NVIDIA API Key (alternative, will be used if LLM_BINDING_API_KEY is not set)
# NVIDIA_API_KEY=your_nvidia_api_key_here

# Timeout Configuration (in seconds)
# Increased timeout for NVIDIA API which can take longer to respond
LLM_TIMEOUT=600

# Optional: Disable API key requirement for local models (set to false for local models only)
# LLM_API_KEY_REQUIRED=true

# ==========================================
# Embedding Configuration (Optional)
# ==========================================
# If using embeddings for RAG/knowledge bases with NVIDIA
# EMBEDDING_BINDING=openai
# EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
# EMBEDDING_BINDING_HOST=https://integrate.api.nvidia.com/v1
# EMBEDDING_BINDING_API_KEY=your_nvidia_api_key_here
# EMBEDDING_DIM=1024
# EMBEDDING_MAX_TOKENS=8192

# ==========================================
# Text-to-Speech Configuration (Optional)
# ==========================================
# TTS_MODEL=tts-1
# TTS_API_KEY=your_openai_api_key_here
# TTS_URL=https://api.openai.com/v1
# TTS_VOICE=alloy
# TTS_TIMEOUT=120

# ==========================================
# System Configuration
# ==========================================
# LANGUAGE=en
# LOG_LEVEL=INFO

